# ─────────────────────────────────────────────────────────────────────────────
# Application & Brand
# ─────────────────────────────────────────────────────────────────────────────
# Canonical public origin (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://maisonaurelia.com"
# Configurable brand name (replaces <BRAND> across UI, emails, metadata, JSON-LD)
NEXT_PUBLIC_SITE_NAME="Maison Aurelia"
# Server environment
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL (Prisma + Driver Adapter)
# ─────────────────────────────────────────────────────────────────────────────
# Pooled URL in production; direct URL for migrations
DATABASE_URL="postgresql://jewellery:jewellery_dev_pass@localhost:5432/jewellery?schema=public"
DIRECT_URL="postgresql://jewellery:jewellery_dev_pass@localhost:5432/jewellery?schema=public"

# Optional host port overrides for docker-compose.yml
POSTGRES_PORT="5432"
REDIS_PORT="6379"
SRH_PORT="8079"
MINIO_API_PORT="9000"
MINIO_CONSOLE_PORT="9001"
MAILPIT_SMTP_PORT="1025"
MAILPIT_UI_PORT="8025"

# ─────────────────────────────────────────────────────────────────────────────
# Better Auth
# ─────────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev_only_replace_with_32_plus_char_secret_key_change_me"
BETTER_AUTH_URL="http://localhost:3000"
# Optional Google OAuth (leave empty to disable "Continue with Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Payments (Stripe or Razorpay chosen per deployment)
# ─────────────────────────────────────────────────────────────────────────────
# Active provider: "stripe" | "razorpay"
PAYMENT_PROVIDER="stripe"
# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Dev/CI test mode sandbox (MUST remain false in production)
PAYMENT_TEST_SANDBOX="true"

# ─────────────────────────────────────────────────────────────────────────────
# S3-Compatible Object Storage (MinIO locally; R2 / S3 in production)
# ─────────────────────────────────────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="jewellery-media"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
# Public CDN prefix for uploaded assets (read-only public/ prefix)
NEXT_PUBLIC_IMAGE_CDN_URL="http://localhost:9000/jewellery-media"

# ─────────────────────────────────────────────────────────────────────────────
# Transactional Email (Resend in prod; Mailpit SMTP in local dev)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="concierge@example.com"
ADMIN_NOTIFY_EMAIL="admin@example.com"
SMTP_HOST="localhost"
SMTP_PORT="1025"

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting & Caching (Upstash Redis; serverless-redis-http or memory in dev)
# ─────────────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL="http://localhost:8079"
UPSTASH_REDIS_REST_TOKEN="dev_upstash_token"
# Direct Redis for Socket.IO horizontal scaling & realtime event pub/sub
REDIS_URL="redis://localhost:6380"
REALTIME_PORT="3001"
NEXT_PUBLIC_REALTIME_URL=""
CHAT_RETENTION_DAYS="365"
CHAT_OFFLINE_EMAIL_COOLDOWN_MINUTES="15"
MALWARE_SCAN_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Cron, Feeds & Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
CRON_SECRET="dev_cron_secret_replace_in_prod"
MERCHANT_FEED_TOKEN="dev_merchant_feed_token"
ENABLE_LLMS_TXT="true"
# NEVER set SEED_DEMO_DATA=true in production
SEED_DEMO_DATA="false"

# Seeded initial admin credentials (used by prisma/seed.ts)
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="AdminChangeMe123!"
ADMIN_SEED_NAME="Maison Director"

# ─────────────────────────────────────────────────────────────────────────────
# Analytics, Search Engine Verification & Monitoring
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
PINTEREST_SITE_VERIFICATION=""
INDEXNOW_KEY=""
CANONICAL_HOST=""
MAINTENANCE_MODE="false"
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Optional Cloudflare Turnstile & abuse controls
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Minimum dwell time (ms) before public form submission is accepted (server time-trap)
ABUSE_TIME_TRAP_MS="1000"

# ─────────────────────────────────────────────────────────────────────────────
# Staging Protection Mode
# ─────────────────────────────────────────────────────────────────────────────
# Set STAGING_MODE=true on preview/staging deployments to enforce noindex everywhere
STAGING_MODE="false"
# Optional HTTP Basic Auth credentials enforced when STAGING_MODE=true
STAGING_BASIC_AUTH_USER=""
STAGING_BASIC_AUTH_PASS=""

