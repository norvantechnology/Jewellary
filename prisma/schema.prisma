generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PriceMode {
  FIXED
  PRICE_ON_REQUEST
}

enum FacetValueType {
  TEXT
  NUMBER
  BOOLEAN
  RANGE
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_FAILED
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum InventoryReason {
  INITIAL
  RESTOCK
  SALE
  RESERVATION
  RELEASE
  RETURN
  ADJUSTMENT
}

enum EnquiryType {
  PRODUCT
  BESPOKE
  GENERAL
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

enum BannerPosition {
  HERO
  STRIP
  EDITORIAL
}

enum PaymentProviderType {
  STRIPE
  RAZORPAY
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  anonymizedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions        Session[]
  accounts        Account[]
  addresses       Address[]
  cart            Cart?
  wishlist        Wishlist?
  orders          Order[]
  auditLogs       AuditLog[]
  enquiries       Enquiry[]
  inventoryEvents InventoryTransaction[]

  @@index([role])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String?
  fullName          String
  phone             String
  line1             String
  line2             String?
  city              String
  state             String
  postalCode        String
  country           String   @db.Char(2)
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  path           String   @unique
  parentId       String?
  description    String?
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent     Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]      @relation("CategoryTree")
  products   Product[]
  facetLinks CategoryFacet[]

  @@index([parentId, isActive, sortOrder])
}

model Product {
  id                    String        @id @default(cuid())
  sku                   String        @unique
  name                  String
  slug                  String        @unique
  status                ProductStatus @default(DRAFT)
  categoryId            String
  subtitle              String?
  description           String?
  priceMode             PriceMode     @default(FIXED)
  basePrice             Decimal       @db.Decimal(12, 2)
  compareAtPrice        Decimal?      @db.Decimal(12, 2)
  costPrice             Decimal?      @db.Decimal(12, 2)
  metalType             String?
  metalColor            String?
  metalPurity           String?
  metalWeightGrams      Decimal?      @db.Decimal(8, 2)
  stoneOrigin           String?
  stoneShape            String?
  caratTotal            Decimal?      @db.Decimal(6, 2)
  caratCenter           Decimal?      @db.Decimal(6, 2)
  colorGrade            String?
  clarityGrade          String?
  cutGrade              String?
  polishGrade           String?
  symmetryGrade         String?
  fluorescence          String?
  certificationLab      String?
  certificateNumber     String?
  certificateUrl        String?
  isFeatured            Boolean       @default(false)
  isNewArrival          Boolean       @default(false)
  isBestseller          Boolean       @default(false)
  hasSizing             Boolean       @default(false)
  leadTimeDays          Int?
  seoTitle              String?
  seoDescription        String?
  ogImageUrl            String?
  canonicalOverride     String?
  noindex               Boolean       @default(false)
  gtin                  String?
  mpn                   String?
  googleProductCategory String?
  searchVector          Unsupported("tsvector")?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants    ProductVariant[]
  images      ProductImage[]
  facetValues ProductFacetValue[]
  enquiries   Enquiry[]

  @@index([categoryId, status])
  @@index([status, isFeatured])
  @@index([status, isBestseller])
  @@index([status, isNewArrival])
  @@index([metalType, stoneShape, status])
  @@index([basePrice])
  @@index([createdAt])
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sku               String   @unique
  title             String
  size              String?
  metal             String?
  stoneSpec         String?
  priceOverride     Decimal? @db.Decimal(12, 2)
  compareAtOverride Decimal? @db.Decimal(12, 2)
  stockQty          Int      @default(0)
  reservedQty       Int      @default(0)
  lowStockThreshold Int      @default(2)
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  weightGrams       Decimal? @db.Decimal(8, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]
  inventoryLogs InventoryTransaction[]

  @@index([productId, isActive])
  @@index([stockQty, reservedQty])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  storageKey String
  url        String
  thumbUrl   String?
  mediumUrl  String?
  altText    String
  width      Int
  height     Int
  focalX     Float?
  focalY     Float?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Facet {
  id           String         @id @default(cuid())
  code         String         @unique
  name         String
  valueType    FacetValueType @default(TEXT)
  isFilterable Boolean        @default(true)
  sortOrder    Int            @default(0)
  unit         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  options       FacetOption[]
  categoryLinks CategoryFacet[]
  productValues ProductFacetValue[]
}

model FacetOption {
  id        String  @id @default(cuid())
  facetId   String
  value     String
  label     String
  sortOrder Int     @default(0)
  swatchHex String?

  facet         Facet               @relation(fields: [facetId], references: [id], onDelete: Cascade)
  productValues ProductFacetValue[]

  @@unique([facetId, value])
  @@index([facetId, sortOrder])
}

model CategoryFacet {
  categoryId String
  facetId    String
  sortOrder  Int    @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  facet    Facet    @relation(fields: [facetId], references: [id], onDelete: Cascade)

  @@id([categoryId, facetId])
}

model ProductFacetValue {
  id           String   @id @default(cuid())
  productId    String
  facetId      String
  optionId     String?
  valueText    String?
  valueNumber  Decimal? @db.Decimal(12, 4)
  valueBoolean Boolean?

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  facet   Facet        @relation(fields: [facetId], references: [id], onDelete: Cascade)
  option  FacetOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([productId, facetId, optionId])
  @@index([facetId, optionId])
  @@index([productId])
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  variantId     String
  reason        InventoryReason
  delta         Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  note          String?
  actorId       String?
  createdAt     DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model SlugRedirect {
  id         String   @id @default(cuid())
  entityType String
  oldSlug    String
  newSlug    String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now())

  @@unique([entityType, oldSlug])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  guestToken String?    @unique
  currency   String     @default("USD")
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id                  String   @id @default(cuid())
  cartId              String
  variantId           String
  quantity            Int      @default(1)
  unitPriceSnapshot   Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Wishlist {
  id         String         @id @default(cuid())
  userId     String?        @unique
  guestToken String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  variantId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, variantId])
}

model Order {
  id                   String      @id @default(cuid())
  orderNumber          String      @unique
  userId               String?
  guestEmail           String?
  guestLookupTokenHash String?
  status               OrderStatus @default(PENDING_PAYMENT)
  currency             String      @default("USD")
  subtotal             Decimal     @db.Decimal(12, 2)
  shippingCost         Decimal     @db.Decimal(12, 2)
  taxAmount            Decimal     @db.Decimal(12, 2)
  taxRateSnapshot      Decimal?    @db.Decimal(5, 4)
  discountAmount       Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @db.Decimal(12, 2)
  shippingMethodName   String
  shippingZoneId       String?
  shippingAddress      Json
  billingAddress       Json
  giftNote             String?
  customerNote         String?
  internalNote         String?
  signatureRequired    Boolean     @default(false)
  trackingNumber       String?
  carrier              String?
  trackingUrl          String?
  idempotencyKey       String?     @unique
  reservedUntil        DateTime?
  paidAt               DateTime?
  shippedAt            DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  refundedAt           DateTime?
  refundedAmount       Decimal     @default(0) @db.Decimal(12, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingZone ShippingZone?        @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     PaymentTransaction[]
  events       OrderEvent[]

  @@index([userId, createdAt])
  @@index([status, reservedUntil])
  @@index([guestEmail])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  variantId            String
  productId            String
  skuSnapshot          String
  titleSnapshot        String
  variantTitleSnapshot String
  imageUrlSnapshot     String?
  quantity             Int
  unitPrice            Decimal @db.Decimal(12, 2)
  lineTotal            Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model PaymentTransaction {
  id               String              @id @default(cuid())
  orderId          String
  provider         PaymentProviderType
  providerIntentId String              @unique
  providerChargeId String?
  amount           Decimal             @db.Decimal(12, 2)
  currency         String
  status           String
  rawResponse      Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model WebhookEvent {
  id          String              @id @default(cuid())
  provider    PaymentProviderType
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  status      String              @default("RECEIVED")
  error       String?
  createdAt   DateTime            @default(now())

  @@unique([provider, eventId])
}

model StoreSetting {
  id                      String   @id @default("default")
  storeName               String   @default("Maison Aurelia")
  tagline                 String?
  contactEmail            String
  contactPhone            String?
  supportHours            String?
  currency                String   @default("USD")
  defaultCountry          String   @default("US") @db.Char(2)
  supportedCountries      String[] @default(["US", "CA", "GB", "AU", "IN"])
  taxRate                 Decimal  @default(0.08) @db.Decimal(5, 4)
  taxLabel                String   @default("Estimated Tax")
  taxInclusive            Boolean  @default(false)
  freeShippingThreshold   Decimal? @db.Decimal(12, 2)
  signatureThreshold      Decimal  @default(500) @db.Decimal(12, 2)
  returnWindowDays        Int      @default(30)
  announcementBarEnabled  Boolean  @default(true)
  announcementBarText     String?
  announcementBarHref     String?
  logoUrl                 String?
  socialLinks             Json?
  physicalStore           Json?
  allowAiCrawlers         Boolean  @default(true)
  seoDefaultTitlePattern  String?
  seoDefaultDescription   String?
  defaultOgImageUrl       String?
  updatedAt               DateTime @updatedAt
}

model ShippingZone {
  id               String   @id @default(cuid())
  name             String
  countries        String[]
  flatRate         Decimal  @db.Decimal(12, 2)
  freeThreshold    Decimal? @db.Decimal(12, 2)
  estimatedDaysMin Int      @default(2)
  estimatedDaysMax Int      @default(5)
  isInsured        Boolean  @default(true)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders Order[]
}

model Banner {
  id             String         @id @default(cuid())
  title          String
  subtitle       String?
  ctaLabel       String?
  ctaHref        String?
  imageUrl       String
  mobileImageUrl String?
  altText        String
  position       BannerPosition @default(HERO)
  isActive       Boolean        @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Article {
  id                  String    @id @default(cuid())
  title               String
  slug                String    @unique
  excerpt             String
  bodyMarkdown        String
  coverImageUrl       String?
  coverAltText        String?
  authorName          String
  isPublished         Boolean   @default(false)
  publishedAt         DateTime?
  seoTitle            String?
  seoDescription      String?
  relatedCategorySlug String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Enquiry {
  id         String        @id @default(cuid())
  type       EnquiryType   @default(GENERAL)
  status     EnquiryStatus @default(NEW)
  name       String
  email      String
  phone      String?
  message    String
  productId  String?
  userId     String?
  staffNote  String?
  assignedTo String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

